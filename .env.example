# Frontend - Firebase public configuration
# VITE_* values are bundled into the frontend and are not server secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MSG_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Frontend - Cloudinary public upload configuration
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Server - Firebase Admin credentials
# Keep these values server-side and configure them in Vercel for the API functions.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Use escaped newline sequences (\\n) when storing a multiline key in an environment variable.
FIREBASE_PRIVATE_KEY=

# Server - Cloudinary credentials
# Keep API secrets server-side; never expose them through VITE_* variables.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Local Vite server configuration
PORT=

# Use .env.local for local values. Real environment files must not be committed.
